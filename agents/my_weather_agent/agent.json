{
  "name": "my_weather_agent",
  "displayName": "My Weather Agent",
  "description": "Fetches weather information for cities using the weather_fetcher tool",
  "url": "http://localhost:8001/a2a/my_weather_agent",
  "version": "1.0.0",
  "protocolVersion": "0.3",
  "capabilities": {},
  "defaultInputModes": [
    "text/plain"
  ],
  "defaultOutputModes": [
    "text/plain"
  ],
  "guardrails": {
    "input": [
      "prompt_injection",
      "jailbreak_detection"
    ],
    "output": [
      "output_validation"
    ],
    "tool": {
      "enabled": [
        "argument_validation",
        "tool_whitelisting"
      ],
      "custom_config": {
        "allowed_tools": [
          "get_weather",
          "load_artifacts",
          "load_memory"
        ]
      }
    },
    "custom_config": {
      "input": {},
      "output": {}
    },
    "traceability": true
  }
}