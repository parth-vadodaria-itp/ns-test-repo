{
  "name": "sample_agent_to_test_guradrails",
  "displayName": "Sample Agent To Test Guradrails",
  "description": "test guardrails",
  "url": "http://localhost:8001/a2a/sample_agent_to_test_guradrails",
  "version": "1.0.0",
  "protocolVersion": "0.3",
  "capabilities": {},
  "defaultInputModes": [
    "text/plain"
  ],
  "defaultOutputModes": [
    "text/plain"
  ],
  "policies": {
    "rules": [
      {
        "field": "role",
        "operator": "in",
        "value": [
          "admin",
          "developer"
        ],
        "description": "Only admin and developer roles allowed"
      },
      {
        "field": "region",
        "operator": "in",
        "value": [
          "US",
          "EU"
        ],
        "description": "Only US and EU regions allowed"
      },
      {
        "field": "time.hour",
        "operator": ">=",
        "value": 9,
        "description": "Not before 9 AM UTC"
      },
      {
        "field": "time.hour",
        "operator": "<=",
        "value": 17,
        "description": "Not after 5 PM UTC"
      },
      {
        "field": "time.weekday",
        "operator": "is_true",
        "value": true,
        "description": "Only on weekdays (Mon-Fri)"
      },
      {
        "field": "tool",
        "operator": "in",
        "value": [
          "web_fetch"
        ],
        "description": "Only web_fetch tool allowed"
      },
      {
        "field": "mcp",
        "operator": "in",
        "value": [
          "web_search"
        ],
        "description": "Only web_search MCP allowed"
      }
    ],
    "effect": "allow"
  },
  "guardrails": {
    "input": [
      "input_validation",
      "jailbreak_detection",
      "prompt_injection",
      "pii_detection",
      "content_policy"
    ],
    "output": [
      "output_validation",
      "content_moderation",
      "output_pii_redaction",
      "quality_analysis"
    ],
    "tool": {
      "enabled": [
        "rbac",
        "data_access_control",
        "rate_limiting",
        "tool_whitelisting"
      ],
      "custom_config": {
        "allowed_tools": [
          "get_account_balances",
          "get_account_ids",
          "add",
          "load_memory",
          "load_artifacts"
        ],
        "role_permissions": {
          "blocked": [],
          "user": [
            "get_account_balances",
            "add"
          ],
          "developer": [
            "get_account_balances",
            "add",
            "get_account_ids"
          ],
          "admin": [
            "get_account_balances",
            "get_account_ids",
            "add"
          ]
        },
        "max_calls_per_minute": 20,
        "restricted_fields": [
          "pan_number",
          "account_number",
          "date_of_birth",
          "password",
          "token"
        ]
      }
    },
    "custom_config": {
      "input": {},
      "output": {}
    },
    "traceability": true
  }
}